# API origin — also the host of the absolute Mercure topic IRIs published by the API
# (DomainEventPublisher builds them with the routing default_uri = DEFAULT_URI). MUST match
# DEFAULT_URI in api/.env (https://localhost) so topic subscriptions line up, and https so
# fetch() from the https://localhost page has no mixed-content block. Served same-origin via Caddy.
VITE_API_BASE=https://localhost
# Mercure hub URL the browser connects to. Relative so it resolves against window.location.origin
# (https://localhost) and reaches the hub same-origin through Caddy.
VITE_MERCURE_URL=/.well-known/mercure
# Casdoor OAuth (Authorization Code + PKCE, public client). MUST be the SAME issuer URL the API
# validates against (CASDOOR_ISSUER in api/.env = http://casdoor:8000): the browser reaches it via
# the `127.0.0.1 casdoor` /etc/hosts entry, and the token `iss` must line up with the API's check.
# The client id is the `dashboard` app seeded in docker/casdoor/init_data.json; its one redirect URI
# is https://localhost/callback (window.location.origin + /callback). No client secret — PKCE only.
VITE_CASDOOR_ISSUER=http://casdoor:8000
VITE_CASDOOR_CLIENT_ID=monparc-dashboard-0a1b2c3d
