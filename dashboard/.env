# Atelier dev env — served same-origin behind Caddy at https://localhost (see vite.config.ts).
#
# API origin. Doubles as the prefix of the absolute Mercure topic IRIs the backend publishes
# (DomainPublisher builds them from DEFAULT_URI = https://localhost), so a subscription topic lines
# up byte-for-byte with the publisher. MUST stay https://localhost: same-origin avoids both the
# mixed-content block on fetch() and any CORS.
VITE_API_BASE=https://localhost
# Mercure hub URL the browser connects to. Relative → resolves against window.location.origin
# (https://localhost) and reaches the hub same-origin through Caddy.
VITE_MERCURE_URL=/.well-known/mercure
# Casdoor OAuth (Authorization Code + PKCE, public client — no secret). Issuer MUST equal the value
# the API validates against (CASDOOR_ISSUER in api/.env = http://casdoor:8000) so the token `iss`
# lines up; the browser reaches it through the same-origin Caddy /casdoor/* proxy at token exchange.
# The client id is the `dashboard` app seeded in api/docker/casdoor/init_data.json; its redirect URI
# is https://localhost/callback — Atelier reuses it (same origin), so no re-seeding is needed.
VITE_CASDOOR_ISSUER=http://casdoor:8000
VITE_CASDOOR_CLIENT_ID=monparc-dashboard-0a1b2c3d
