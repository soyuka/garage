# API origin — also the host of the absolute Mercure topics published by the API
# (DomainEventPublisher builds them with the routing default_uri = DEFAULT_URI).
VITE_API_BASE=http://localhost
# Mercure hub URL the browser connects to. Relative in dev so it goes through the Vite proxy
# (the hub has no CORS for the dev origin); resolved against window.location.origin.
VITE_MERCURE_URL=/.well-known/mercure
