{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	root /app/public
	# Since Caddy 2.11.7 `encode` compresses Server-Sent Events, holding an encoder (several MiB) per
	# subscriber for the life of the stream, and mixing private updates with attacker-influenced data
	# in one compressed stream is BREACH-shaped. Mercure 1.0.4 upgrade notes.
	@compressible not path /.well-known/mercure*
	encode @compressible zstd br gzip

	vulcain

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
	header ?Permissions-Policy "browsing-topics=()"
	header ?X-Content-Type-Options nosniff
	header ?Referrer-Policy strict-origin-when-cross-origin

	# Request bodies are capped at the edge, 1 MiB by default. Only the routes that take a file get
	# more, each sized to the app's own cap plus the envelope, so an oversized body is cut before PHP
	# buffers it: a finder turn carries up to TurnInputLimits::MAX_IMAGES (4) photos of MAX_IMAGE_BYTES
	# (4 MiB) as base64 data URLs in JSON (~21.4 MiB); photo intake and the registration document are
	# multipart, at most MAX_DOCUMENT_BYTES (10 MiB). conf.d/10-app.ini mirrors these.
	@turnWithPhotos path /agent/turn
	request_body @turnWithPhotos {
		max_size 24MiB
	}
	@intakeUpload path /photo-intake /registration-documents/extract
	request_body @intakeUpload {
		max_size 11MiB
	}
	@ordinaryBody not path /agent/turn /photo-intake /registration-documents/extract
	request_body @ordinaryBody {
		max_size 1MiB
	}

	# route {} enforces strict first-match-wins in file order (Caddy's default directive order runs
	# rewrite before reverse_proxy).
	route {
		# Symfony's debug surfaces (profiler, toolbar, error previews) expose phpinfo, every env secret and
		# the bearer tokens stored in profiles: 404 even if APP_ENV=dev slips through, unless the request is
		# local on every count. A Host header is the client's to write, so it is not enough on its own: the
		# peer must also be loopback or the docker bridge (a host browser goes through the published port),
		# and nothing may have proxied it (cloudflared and the host Caddy both add X-Forwarded-For). An
		# internet client keeps its own address through docker's DNAT.
		@debugSurface {
			path /_profiler* /_wdt* /_error*
			not {
				host localhost 127.0.0.1
				remote_ip private_ranges
				header !X-Forwarded-For
				header !Forwarded
				header !Cf-Connecting-Ip
			}
		}
		respond @debugSurface 404

		# The hub itself lives on the internal site below, declared exactly once. Browser subscribers
		# arrive here, so this address forwards to it; Caddy streams an SSE response through
		# reverse_proxy without buffering.
		reverse_proxy /.well-known/mercure* http://{$MERCURE_HUB_UPSTREAM:php:80} {
			header_up Host {$MERCURE_HUB_HOST:php}
		}

		@phpRoute {
			not path /.well-known/mercure*
			not file {path}
		}
		rewrite @phpRoute index.php

		@frontController path index.php
		php @frontController {
			{$FRANKENPHP_SITE_CONFIG}

			worker {
				file ./public/index.php
				{$FRANKENPHP_WORKER_CONFIG}
			}
		}

		file_server {
			hide *.php
		}
	}
}

# The single Mercure hub, on the in-network address the app publishes to. Mercure 1.0 refuses a
# second unnamed hub anywhere in the configuration, and each `mercure` directive provisions its own. SERVER_NAME can carry several addresses, and addresses that differ in scheme land in
# different Caddy servers, so a hub on the public site is instantiated once per server and the
# config is rejected. Declaring it here keeps it to one, whatever SERVER_NAME holds; the public
# addresses reverse_proxy to it.
http://php:80 {
	handle /.well-known/mercure* {
		mercure {
			# Mercure 1.0 dropped the top-level publisher_jwt/subscriber_jwt directives: keys now hang off
			# the issuer that signed the token. `iss` must equal this identifier and `aud` must equal
			# resource_identifier, both minted by config/packages/mercure.yaml.
			issuer {$MERCURE_JWT_ISSUER:https://bonneref.fr} {
				publisher {
					jwt {env.MERCURE_PUBLISHER_JWT_KEY}
				}
				subscriber {
					jwt {env.MERCURE_SUBSCRIBER_JWT_KEY}
				}
			}
			# Subscribers reach this hub through the public address, so the audience tokens carry is the
			# public URL and cannot be derived from the request.
			resource_identifier {$MERCURE_PUBLIC_URL:https://localhost:8444/.well-known/mercure}
			# No `anonymous`: every frame is published private, and a subscriber needs the per-session
			# token GET /agent/link mints (src/Controller/AgentLinkController.php). A topic selector such
			# as `*` would otherwise stream every owner's frames to anyone.
			# No `subscriptions`: nothing reads the subscription API, and it would announce every
			# subscriber's topic, pilot digests included.
			# Extra directives
			{$MERCURE_EXTRA_DIRECTIVES}
		}
	}
}
