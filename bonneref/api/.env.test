# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Domain store: a separate Mongo database so the suite never touches dev data. Mongo has no
# transactional rollback, so AppTestCase drops the whole database in setUp().
MONGODB_DB=bonneref_test

# Fake upstream credential — all HTTP is served by tests/Mock/FixtureHttpClient.
API_PLAQUE_TOKEN=test-token

# OIDC: tokens are decoded by FakeOidcTokenHandler, so these are never hit by the cryptographic
# handler.
# Audience: FakeOidcToken::ATELIER_CLIENT is the front; mpa-test-client stands for mpa's forwarded
# bearer on the catalogue routes. The MCP resource alias is forced in phpunit.dist.xml.
OAUTH_CLIENT_AUDIENCES=test-atelier-client
CATALOGUE_PASSTHROUGH_AUDIENCES=mpa-test-client

# MCP_ALLOWED_HOSTS is NOT set here on purpose: a container env var would win over it. It is forced
# in phpunit.dist.xml instead (see McpAllowedHostsTest).

# The derived TecDoc catalogue the suite reads: built from tests/Fixtures/tecdoc (TecdocFixtureDatabase).
# Resolved by the container's own env in tests that build their own catalogue.
TECDOC_CATALOG_PATH=%kernel.project_dir%/var/test-tecdoc.sqlite

# Pinned so journal cost assertions do not follow price changes in .env
AGENT_PRICES='{"claude-sonnet-5-5":{"input":2,"output":10,"cache_read":0.20,"cache_write":2.50},"claude-haiku-5-5":{"input":0.10,"output":0.50,"cache_read":0.01,"cache_write":0.125}}'
