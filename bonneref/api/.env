# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# The dev stack publishes HTTPS on host port 8444 (compose.yaml: HTTPS_PORT) so it never clashes with
# mon-parc-auto's :443. Caddy listens on 443 inside the container whatever the host port is.
SERVER_NAME=https://localhost
# Canonical origin for absolute URLs generated outside a request (CLI) and for the Mercure session
# topic a finder turn publishes to. Must match the front's VITE_API_BASE so topic subscriptions line
# up. https so the browser has no mixed-content block.
DEFAULT_URI=https://localhost:8444
###< symfony/routing ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> casdoor oidc ###
# Hosted Casdoor (auth.bonneref.fr), outside this stack. The issuer is the OIDC `iss` claim of every
# token. CasdoorTokenHandler fetches $CASDOOR_ISSUER/.well-known/openid-configuration and the JWKS it
# points to server-side, so the php container needs outbound https.
CASDOOR_ISSUER=https://auth.bonneref.fr
# Audience (../../api/docs/AUTH.md). /mcp accepts a token whose `aud` is this server's resource URI:
# DEFAULT_URI + /mcp, plus MCP_RESOURCE_ALIASES (comma-separated full URIs). Empty here: .env is baked
# into the prod image.
MCP_RESOURCE_ALIASES=
# The REST firewall accepts the bonneref front's PKCE tokens (aud = its client_id).
OAUTH_CLIENT_AUDIENCES=89646c002d2272351ca2
# DEBT (FUTURE.md "Token passthrough mpa -> bonneref"): mpa forwards its caller's bearer, so the GET
# catalogue routes mpa calls also accept mpa's audiences: the Atelier client and mpa's MCP resource URIs
# (garage.bonneref.fr, and garage.soyuka.me for the stage pilot). Never /mcp.
CATALOGUE_PASSTHROUGH_AUDIENCES=671b8c86d75444f3f4c4,https://garage.bonneref.fr/mcp,https://garage.soyuka.me/mcp
# The owner key is the `email` claim (app.owner_claim), so it must be verified: Casdoor's `email_verified`
# must be true or the token is refused. Only turn this off while existing accounts are being verified.
OWNER_REQUIRE_VERIFIED_EMAIL=true
###< casdoor oidc ###

###> app: mcp host allowlist ###
# The MCP SDK's DNS-rebinding guard defaults to localhost only, so on any public hostname every
# AUTHENTICATED /mcp request 403s with "Invalid Host header." while unauthenticated ones still 401
# correctly, which reads as an OAuth failure and is not one. List every host the endpoint is served on.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
###< app ###

###> app: upstream data sources (real values in .env.local, NEVER here) ###
# apiplaqueimmatriculation.com — plate → SIV vehicle data
API_PLAQUE_TOKEN=
# The derived TecDoc catalogue (docs/tecdoc-sqlite.md). The compose files mount it at this path.
TECDOC_CATALOG_PATH=/srv/tecdoc/catalog.sqlite
###< app ###

###> doctrine/doctrine-bundle ###
# Only read when AGENT_TURN_DISPATCH=messenger with a doctrine:// transport (compose `messenger`
# profile). The default setup (terminate + in-memory) never opens a connection.
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5433/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> doctrine/mongodb-odm-bundle ###
# The domain store. In the compose network the host is `mongodb`; on a host-run `symfony serve` it is
# 127.0.0.1 (the dev override publishes 27018). The database name is carried separately (MONGODB_DB)
# so the connection URL stays db-agnostic.
MONGODB_URL="mongodb://127.0.0.1:27018"
MONGODB_DB="bonneref"
###< doctrine/mongodb-odm-bundle ###

###> symfony/mercure-bundle ###
# Server-side PUBLISH target. Must be plain-HTTP internal so PHP's curl never hits Caddy's untrusted
# local CA (https://localhost fails TLS verify and the publish throws). Matches the compose default;
# in the container compose's real env (http://php) wins over this anyway.
MERCURE_URL=http://php/.well-known/mercure
# The public URL of the Mercure hub, used by the browser to connect
MERCURE_PUBLIC_URL=https://localhost:8444/.well-known/mercure
# The secret used to sign the JWTs
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
# Identifies this app as the token issuer; must equal the hub's `issuer` block (Mercure 1.0).
MERCURE_JWT_ISSUER=https://bonneref.fr
###< symfony/mercure-bundle ###

###> symfony/ai-bundle ###
# Journal cost estimate: JSON map of model id (as the journal records it) => USD per million tokens.
# A turn on a model absent from the map shows no cost. Empty = no cost shown.
# claude-sonnet-5-5 and claude-haiku-5-5 first-party list prices (USD/MTok, checked 2026-11-10; haiku = the <=100K-prompt card, $0.50/$2.50 beyond); cache write = 5-minute TTL (1.25x input)
# Anthropic: platform.claude.com/docs/en/about-claude/pricing, Google: ai.google.dev/gemini-api/docs/pricing (checked 2026-11-10).
# claude-haiku-4-5 and gemini-2.5-flash are the web-search side calls. Gemini has no cache-write fee (cache_write = input).
# Not in this map: web search per-request fees (Anthropic $10/1k searches, Gemini grounding $35/1k prompts beyond 1,500/day).
AGENT_PRICES='{"claude-sonnet-5-5":{"input":2,"output":10,"cache_read":0.1,"cache_write":2.5},"claude-haiku-5-5":{"input":0.1,"output":0.5,"cache_read":0.01,"cache_write":0.125},"claude-haiku-4-5":{"input":1,"output":5,"cache_read":0.1,"cache_write":1.25},"gemini-2.5-flash":{"input":0.3,"output":2.5,"cache_read":0.03,"cache_write":0.3}}'
# Anthropic web_search server tool, USD per search ($10 per 1,000), charged to the turn on top of the side call's tokens.
AGENT_WEB_SEARCH_USD=0.01
# Backend that grounds the out-of-band web-search call: anthropic (Haiku + native web_search) or
# gemini (Gemini + Google Search grounding). Switch with a one-line edit + restart — no recompile.
# The unused backend's platform stays lazy, so only the selected key must be set.
WEB_SEARCH_BACKEND=anthropic
# Model for the Anthropic web-search backend (parses ?max_tokens= like the agent model string).
WEB_SEARCH_MODEL=claude-haiku-4-5?max_tokens=2048
# Comma-separated domains the Anthropic web search may read (allowed_domains); empty = the whole web. Gemini ignores it.
WEB_SEARCH_ALLOWED_DOMAINS=
# Model for the Gemini web-search backend (a Google Search-grounding capable flash model).
GEMINI_WEB_SEARCH_MODEL=gemini-2.5-flash
###< symfony/ai-bundle ###

###> symfony/ai-anthropic-platform ###
# The finder agent, the photo intake and the carte grise reader. Real value belongs in .env.local.
ANTHROPIC_API_KEY=
###< symfony/ai-anthropic-platform ###

###> symfony/ai-gemini-platform ###
# Used ONLY by the out-of-band web-search backend (App\Agent\WebSearch\GeminiWebSearchClient).
GEMINI_API_KEY=
###< symfony/ai-gemini-platform ###

###> symfony/messenger ###
# In-memory by default: with AGENT_TURN_DISPATCH=terminate nothing is queued. For
# AGENT_TURN_DISPATCH=messenger point these at a real transport, e.g.
# MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1 and
# MESSENGER_FAILED_TRANSPORT_DSN=doctrine://default?queue_name=failed (then `docker compose --profile messenger up`).
MESSENGER_TRANSPORT_DSN=in-memory://
MESSENGER_FAILED_TRANSPORT_DSN=in-memory://
###< symfony/messenger ###

###> agent turn dispatch ###
# Where POST /agent/turn runs the agent turn:
#   messenger — enqueue on the async transport, consumed by the `worker` container (compose profile `messenger`).
#   terminate — run it in kernel.terminate of the same request, after the 202 is sent. No worker needed;
#               the PHP thread is busy for the turn's duration.
AGENT_TURN_DISPATCH=terminate
# terminate mode only: set_time_limit() for the turn, in seconds.
AGENT_TURN_TIME_LIMIT=120
###< agent turn dispatch ###

###> symfony/lock ###
# Serialises the rate-limiter read-modify-write, so a burst of parallel requests cannot slip past a
# quota. flock: one FrankenPHP container on one host.
LOCK_DSN=flock
###< symfony/lock ###

###> per-owner quotas ###
# Per authenticated owner (Casdoor email), per sliding hour. Over the limit: 429 + Retry-After, or a
# `rate_limited` tool result over MCP.
# Finder turns (POST /agent/turn) — each one spends Anthropic credits.
AGENT_TURN_RATE_LIMIT=30
# SIV plate lookups that miss the store and bill the API Plaque token (GET /vehicles/{plate}, MCP lookup_plate).
PLATE_LOOKUP_RATE_LIMIT=60
# Vision intakes (POST /photo-intake, POST /registration-documents/extract) — one Sonnet call each.
INTAKE_RATE_LIMIT=30
# Estimated finder spend per owner over a sliding 24 hours, in USD (journal cost, priced by AGENT_PRICES). Over it: 429.
AGENT_DAILY_BUDGET_USD=1.00
# The same two paid paths across ALL owners, per sliding hour: caps a burst of fresh accounts.
AGENT_TURN_GLOBAL_RATE_LIMIT=300
PLATE_LOOKUP_GLOBAL_RATE_LIMIT=200
###< per-owner quotas ###
