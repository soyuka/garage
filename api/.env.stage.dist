# ── STAGE profile — the conference rig ────────────────────────────────────────────────────────
#
# Template. Copy to `.env.stage` (gitignored) and fill every CHANGEME before opening the tunnel.
# Used ONLY when the stack is publicly reachable:
#
#   docker compose --env-file .env.stage -f compose.yaml -f compose.override.yaml -f compose.stage.yaml up -d
#
# Daily development keeps using plain `.env` and its insecure defaults, untouched. See CONFERENCE.md
# workstream A, and docs/pilot.md for what the pilot channel does with these values.
#
# WHY a separate profile at all: a Cloudflare tunnel publishes THIS stack at a public hostname. The
# dev defaults (Postgres `!ChangeMe!`) are a takeover of the
# stack behind /mcp. Rotating them in `.env` instead would invalidate the pilot
# topic and the token in ~/.claude.json that daily Claude Code work depends on.

# ── Hostnames ────────────────────────────────────────────────────────────────────────────────
# ONE public host (garage.soyuka.me), one tunnel, one ingress rule (docker/cloudflared/config.yml.dist).
# Auth lives outside this stack, at the hosted Casdoor https://auth.bonneref.fr.
#
# Caddy serves both addresses from one site block:
#   - https://localhost keeps its internal self-signed cert — the projector browser stays here, so
#     the Mercure render path never leaves the machine (see CONFERENCE.md A.1).
#   - http://garage.soyuka.me is plain HTTP inside; Cloudflare terminates real TLS at the edge.
#     Auto-HTTPS must NOT try to issue a cert for it — the scheme prefix is what tells Caddy so.
SERVER_NAME=https://localhost, http://garage.soyuka.me

# The pilot-topic base (DashboardChannel::pilotTopic, src/Agent/Ui/DashboardChannel.php:66). It is
# server-side and host-independent by design, which is exactly why the browser can sit on localhost
# while Claude Desktop arrives on the tunnel host and both still land on the same topic. Leave it.
DEFAULT_URI=https://localhost

# Cloudflare + cloudflared set X-Forwarded-Proto: https. Without trusting them,
# McpProtectedResourceChallengeListener.php:38 derives `http://…` from the request and advertises a
# non-HTTPS metadata URL to Claude Desktop. Symfony's framework default already reads this env
# (config/reference.php:146), so no config change is needed. REMOTE_ADDR, not private_ranges: the ports
# are loopback-only, so the direct peer is the docker gateway relaying cloudflared or a local client.
SYMFONY_TRUSTED_PROXIES=REMOTE_ADDR

# The hosted Casdoor: the token `iss`, and where CasdoorTokenHandler fetches discovery + JWKS
# (outbound https from the php container). Must equal the `issuer` of its discovery document exactly.
CASDOOR_ISSUER=https://auth.bonneref.fr
# The organization whose users may sign in (the token's `owner` claim); emails are unique per org only.
CASDOOR_ORGANIZATION=bonneref
# mpa's own credential for bonneref (Casdoor application `mpa-service`, client credentials). Required.
MPA_SERVICE_CLIENT_ID=466fc97138f0f6348ec3
MPA_SERVICE_CLIENT_SECRET=

# The SPA is served from https://localhost, so keep its hub there too.
CADDY_MERCURE_PUBLIC_URL=https://localhost/.well-known/mercure

# Every hostname /mcp is served on. The MCP SDK's DNS-rebinding guard is localhost-only by default
# and symfony/mcp-bundle exposes no config for it, so omitting the public host here makes every
# AUTHENTICATED request 403 "Invalid Host header." while unauthenticated ones still 401 — which
# looks like a credentials problem and is not one. localhost stays listed: the projector browser
# and the local test flows still use it.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],garage.soyuka.me
# The resource URIs /mcp accepts in a token's `aud` besides DEFAULT_URI/mcp: Claude Code via the tunnel
# binds its token to https://garage.soyuka.me/mcp; plain-HTTP local clients to http://localhost/mcp.
MCP_RESOURCE_ALIASES=http://localhost/mcp,https://garage.soyuka.me/mcp


# ── Secrets — every one of these is CHANGEME ─────────────────────────────────────────────────
# APP_SECRET is not just Symfony's signing key here: it is the HMAC key deriving the owner topics
# (pilot, fleet, session). Generate: openssl rand -hex 32
APP_SECRET=CHANGEME

# openssl rand -hex 32
CADDY_MERCURE_JWT_SECRET=CHANGEME

# ── Deliberately NOT rotated: Postgres ──────────────────────────────────────────────────────
# Two reasons, both load-bearing:
#
#  1. It is not reachable through the tunnel. Ingress routes exactly one hostname, to :80;
#     everything else falls through to `http_status:404`
#     (docker/cloudflared/config.yml.dist). Rotating it hardens nothing an attacker can touch.
#  2. Postgres applies its root credentials ONLY when initialising an empty data
#     directory. The `database_data` volume was created with these values, so a
#     new password here does not change the stored one — it just fails to authenticate, and the
#     stack comes up broken in a way that looks like a config bug.
#
# If you ever DO need this rotated, the honest way is a separate compose project name (its own
# volume set), not new values against the old volumes.
POSTGRES_PASSWORD=!ChangeMe!
POSTGRES_USER=app
POSTGRES_DB=app

# ── NOT here: the third-party API credentials ────────────────────────────────────────────────
# ANTHROPIC_API_KEY and friends live in `.env.local`, which is
# bind-mounted into the container at /app/.env.local and read by Symfony's Dotenv in every profile.
# They carry over untouched. Do NOT duplicate them here: a second copy is a second thing to rotate
# and a second way for the two to drift.
#
# This file is for docker-compose INTERPOLATION plus the handful of variables compose.stage.yaml
# promotes to container environment. Nothing else belongs in it.
