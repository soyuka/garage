# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
# TLS on :443 — the browser dashboard is served at https://localhost. Caddy auto-redirects :80.
# (Goose Flatpak MCP needs plain http://localhost/mcp; re-add ",http://localhost" here when that
# comes back — no space after the comma, Symfony Dotenv rejects unquoted spaces.)
SERVER_NAME=https://localhost
# Canonical origin for absolute URLs generated outside a request (CLI) and for the Mercure topic
# IRIs built by DomainEventPublisher. Must match the dashboard's VITE_API_BASE so topic
# subscriptions line up. https so the browser (on https://localhost) has no mixed-content block.
DEFAULT_URI=https://localhost
###< symfony/routing ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> casdoor oidc ###
# Public issuer URL of the Casdoor instance (the OIDC `iss` claim). The discovery document
# is fetched from $CASDOOR_ISSUER/.well-known/openid-configuration; the JWKS it points to
# validates /mcp token signatures. No audience var: Casdoor sets `aud` to the per-DCR dynamic
# client_id, so CasdoorTokenHandler validates issuer + signature only (see the class docblock).
# Uses the bare service name `casdoor` (not `localhost`): the issuer is both the token `iss`
# AND the URL the php container fetches discovery/JWKS from, so it must be one URL reachable
# from both sides. `localhost` inside the container is the container itself (discovery fails).
# `casdoor` resolves via compose DNS in-container and via an /etc/hosts entry on the host —
# add `127.0.0.1 casdoor` to /etc/hosts so Goose/the browser can reach the published :8000.
CASDOOR_ISSUER=http://casdoor:8000
###< casdoor oidc ###

###> app: upstream data sources (real values in .env.local, NEVER here) ###
# apiplaqueimmatriculation.com — plate → SIV vehicle data
API_PLAQUE_TOKEN=
# partsapi.ru — one key PER method (see docs/PARTSAPI.md)
PARTSAPI_KEY_getMakes=
PARTSAPI_KEY_getModels=
PARTSAPI_KEY_getCars=
PARTSAPI_KEY_getSearchTree=
PARTSAPI_KEY_getArticles=
PARTSAPI_KEY_GetFillVolumes=
# self-imposed per-method call ceiling (demo allowance protection)
PARTSAPI_CALL_LIMIT=50
# partsapi language id for group/article names (6 = Français, 4 = English GB — see docs/PARTSAPI.md)
PARTSAPI_LANG=6
# Motul Oil Advisor — locale + business unit segment the catalog. This is a French garage: the
# fr-FR/FRA catalog carries European vehicles (e.g. Peugeot) the en-US/USA catalog does not.
MOTUL_LOCALE=fr-FR
MOTUL_BU=FRA
###< app ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> doctrine/mongodb-odm-bundle ###
# The garage domain store. In the compose network the host is `mongodb`; on a host-run
# `symfony serve` it is 127.0.0.1 (the dev override publishes 27017). The database name is
# carried separately (MONGODB_DB) so the connection URL stays db-agnostic.
MONGODB_URL="mongodb://127.0.0.1:27017"
MONGODB_DB="app"
###< doctrine/mongodb-odm-bundle ###

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# The URL of the Mercure hub, used by the app to publish updates (can be a local URL).
# Server-side PUBLISH target. Must be plain-HTTP internal so PHP's curl never hits Caddy's
# untrusted local CA (https://localhost fails TLS verify: "unable to get local issuer
# certificate" → publish throws → 500, no UI). Matches the compose default; in the container
# compose's real env (http://php) wins over this anyway. Host `symfony serve` needs an
# /etc/hosts php→127.0.0.1 entry (or a .env.local override) to resolve this name.
MERCURE_URL=http://php/.well-known/mercure
# The public URL of the Mercure hub, used by the browser to connect
MERCURE_PUBLIC_URL=https://localhost/.well-known/mercure
# The secret used to sign the JWTs
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
###< symfony/mercure-bundle ###

###> symfony/ai-bundle ###
# Garage agent chat provider — see docs/AGENT_PROVIDER.md for how to switch.
# Anthropic API key for the in-app garage agent. Real value belongs in .env.local (gitignored).
ANTHROPIC_API_KEY=
# Alibaba Cloud Qwen (OpenAI-compatible MaaS endpoint). Key belongs in .env.local.
# base_url stops at /compatible-mode; the generic bridge appends /v1/chat/completions.
ALIBABACLOUD_API_KEY=
QWEN_BASE_URL=https://ws-cchfndp3ldtdfudj.ap-southeast-1.maas.aliyuncs.com/compatible-mode
# Web search is the `web_search` custom tool (App\Agent\WebSearch\WebSearchTool), backed by a separate
# Haiku call — independent of whichever model orchestrates the turn. So the main loop carries NO
# provider-native web search: keep AGENT_WEB_SEARCH=off. The legacy per-platform mechanism
# (App\Agent\WebSearchInputProcessor: anthropic = server_tools block; qwen = DashScope enable_search)
# stays available but MUST NOT run alongside the tool — both declare a `web_search` and Anthropic
# rejects duplicate tool names. Only flip this to anthropic|qwen if you remove the custom tool.
AGENT_WEB_SEARCH=off
# Model for the out-of-band web-search call (parses ?max_tokens= like the agent model string).
WEB_SEARCH_MODEL=claude-haiku-4-5?max_tokens=2048
###< symfony/ai-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
###< symfony/messenger ###
