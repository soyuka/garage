# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration
#
# ── What a fresh clone needs (2026-11-09) ─────────────────────────────────────────────────────────
# NOTHING in .env.local: every value below has a working default for the compose stack, auth is the
# hosted Casdoor (CASDOOR_ISSUER=https://auth.bonneref.fr) and the catalogue is BONNEREF_API_URL
# (https://bonneref.fr). The garage, the dashboard and the MCP server run with no paid key at all.
#
# Paid keys are optional, one feature each. An empty key switches its feature OFF, never broken
# (App\Capability\Capabilities; the dashboard reads them from GET /agent/link `capabilities`):
#   ANTHROPIC_API_KEY   the in-app agent (dock). Required for agent turns, which answer 503
#                       "agent not configured" without it. Default provider of the agent.
#   GEMINI_API_KEY      the agent's web_search tool (WEB_SEARCH_BACKEND=gemini). Absent = no web_search.
#   ELEVENLABS_API_KEY  the Atelier's voice (/tts) and dictation (/stt). Absent = both hidden.
#   ALIBABACLOUD_API_KEY only if ai.yaml's agent is toggled to Qwen (docs/AGENT_PROVIDER.md).
# Production also sets APP_SECRET, the Mercure secret, SERVER_NAME/DEFAULT_URI and MCP_ALLOWED_HOSTS
# (see .env.stage.dist).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
# TLS on :443 — the browser dashboard is served at https://localhost. Caddy auto-redirects :80.
# (Goose Flatpak MCP needs plain http://localhost/mcp; re-add ",http://localhost" here when that
# comes back — no space after the comma, Symfony Dotenv rejects unquoted spaces.)
SERVER_NAME=https://localhost
# Canonical origin for absolute URLs generated outside a request (CLI) and for the Mercure topic
# IRIs built by DomainEventPublisher. Must match the dashboard's VITE_API_BASE so topic
# subscriptions line up. https so the browser (on https://localhost) has no mixed-content block.
DEFAULT_URI=https://localhost
###< symfony/routing ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> casdoor oidc ###
# Hosted Casdoor (auth.bonneref.fr), outside this stack. The issuer is the OIDC `iss` claim of
# every token. CasdoorTokenHandler fetches $CASDOOR_ISSUER/.well-known/openid-configuration and the
# JWKS it points to server-side, so the php container needs outbound https.
CASDOOR_ISSUER=https://auth.bonneref.fr
# The Casdoor organization whose users may sign in (the token's `owner` claim). The issuer is the whole
# instance, and emails, the tenancy key, are unique per organization only. Required:
# token (CasdoorTokenHandler fails closed when empty). Every user of auth.bonneref.fr is in `bonneref`.
CASDOOR_ORGANIZATION=bonneref
# Audience (docs/AUTH.md). /mcp accepts a token whose `aud` is this server's resource URI: DEFAULT_URI
# + /mcp, plus MCP_RESOURCE_ALIASES (comma-separated full URIs) for any other origin the same deployment
# answers on. Empty here on purpose: .env is baked into the prod image, and a localhost alias there
# would let prod accept tokens minted for someone's local server. Dev aliases live in .env.dev.
MCP_RESOURCE_ALIASES=
# The REST firewall accepts tokens of our own browser front ends, whose PKCE tokens carry
# aud = client_id: the Atelier, and the bonneref front (it reaches /garage/* cross-origin).
OAUTH_CLIENT_AUDIENCES=671b8c86d75444f3f4c4,89646c002d2272351ca2
# The owner key is the `email` claim (app.owner_claim), so it must be verified: Casdoor's `email_verified`
# must be true or the token is refused. Only turn this off while existing accounts are being verified.
OWNER_REQUIRE_VERIFIED_EMAIL=true
###< casdoor oidc ###
###> app: mcp host allowlist ###
# The MCP SDK's DNS-rebinding guard (DnsRebindingProtectionMiddleware) defaults to localhost only,
# and symfony/mcp-bundle gives no config hook — so on any public hostname every AUTHENTICATED /mcp
# request 403s with "Invalid Host header." while unauthenticated ones still 401 correctly, which
# reads as an OAuth failure and is not one. List every host the endpoint is served on.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
###< app ###


###> app: upstream data sources ###
# bonneref: the parts catalogue (makes, models, cars, categories, articles, narrowing) and the plate
# registry (SIV) are served over HTTP. No trailing slash.
BONNEREF_API_URL=https://bonneref.fr
# mpa calls bonneref as itself: client credentials of the Casdoor application `mpa-service` (minted at
# CASDOOR_ISSUER), the end user named in X-Bonneref-Owner. The client id is public; put the secret in
# .env.local (dev) or .env.stage. Unset, every catalogue call fails with a not_configured error.
MPA_SERVICE_CLIENT_ID=466fc97138f0f6348ec3
MPA_SERVICE_CLIENT_SECRET=
# Motul Oil Advisor — locale + business unit segment the catalog. This is a French garage: the
# fr-FR/FRA catalog carries European vehicles (e.g. Peugeot) the en-US/USA catalog does not.
MOTUL_LOCALE=fr-FR
MOTUL_BU=FRA
###< app ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> doctrine/mongodb-odm-bundle ###
# The garage domain store. In the compose network the host is `mongodb`; on a host-run
# `symfony serve` it is 127.0.0.1 (the dev override publishes 27017). The database name is
# carried separately (MONGODB_DB) so the connection URL stays db-agnostic.
MONGODB_URL="mongodb://127.0.0.1:27017"
MONGODB_DB="app"
###< doctrine/mongodb-odm-bundle ###

###> symfony/mercure-bundle ###
# See https://symfony.com/doc/current/mercure.html#configuration
# The URL of the Mercure hub, used by the app to publish updates (can be a local URL).
# Server-side PUBLISH target. Must be plain-HTTP internal so PHP's curl never hits Caddy's
# untrusted local CA (https://localhost fails TLS verify: "unable to get local issuer
# certificate" → publish throws → 500, no UI). Matches the compose default; in the container
# compose's real env (http://php) wins over this anyway. Host `symfony serve` needs an
# /etc/hosts php→127.0.0.1 entry (or a .env.local override) to resolve this name.
MERCURE_URL=http://php/.well-known/mercure
# The public URL of the Mercure hub, used by the browser to connect
MERCURE_PUBLIC_URL=https://localhost/.well-known/mercure
# The secret used to sign the JWTs
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
# The secret signing subscriber tokens (the hub's MERCURE_SUBSCRIBER_JWT_KEY).
MERCURE_SUBSCRIBER_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
# Identifies this app as the token issuer; must equal the hub's `issuer` block (Mercure 1.0).
MERCURE_JWT_ISSUER=https://mon-parc-auto.fr
# Lifetime (seconds) of the subscriber cookie GET /agent/link sets; the dashboard asks again when the hub refuses its stream.
MERCURE_SUBSCRIBER_TOKEN_TTL=3600
###< symfony/mercure-bundle ###

###> symfony/ai-bundle ###
# Garage agent chat provider — see docs/AGENT_PROVIDER.md for how to switch.
# Anthropic API key for the in-app garage agent. Real value belongs in .env.local (gitignored).
# Empty = no agent turns (503 "agent not configured"); MCP and the garage are unaffected.
ANTHROPIC_API_KEY=
# Alibaba Cloud Qwen (OpenAI-compatible MaaS endpoint). Key belongs in .env.local.
# base_url stops at /compatible-mode; the generic bridge appends /v1/chat/completions.
ALIBABACLOUD_API_KEY=
QWEN_BASE_URL=https://ws-cchfndp3ldtdfudj.ap-southeast-1.maas.aliyuncs.com/compatible-mode
# Google Gemini API key — used ONLY by the out-of-band web-search backend (App\Agent\WebSearch\
# GeminiWebSearchClient), not the garage chat. Real value belongs in .env.local (gitignored).
# Kept on purpose: owner decision 2026-11-09, Gemini stays the web-search backend.
# Empty = the agent has no web_search tool (not a crash).
GEMINI_API_KEY=
# Web search is the `web_search` custom tool (App\Agent\WebSearch\WebSearchTool), backed by a separate
# focused call — independent of whichever model orchestrates the turn. So the main loop carries NO
# provider-native web search: keep AGENT_WEB_SEARCH=off. The legacy per-platform mechanism
# (App\Agent\WebSearchInputProcessor: anthropic = server_tools block; qwen = DashScope enable_search)
# stays available but MUST NOT run alongside the tool — both declare a `web_search` and Anthropic
# rejects duplicate tool names. Only flip this to anthropic|qwen if you remove the custom tool.
AGENT_WEB_SEARCH=off
# Journal cost estimate: JSON map of model id (as the journal records it) => USD per million tokens.
# A turn on a model absent from the map shows no cost. Empty = no cost shown.
# claude-sonnet-5-5 and claude-haiku-5-5 first-party list prices (USD/MTok, checked 2026-11-10; haiku = the <=100K-prompt card, $0.50/$2.50 beyond); cache write = 5-minute TTL (1.25x input)
# Anthropic: platform.claude.com/docs/en/about-claude/pricing, Google: ai.google.dev/gemini-api/docs/pricing (checked 2026-11-10).
# claude-haiku-4-5 and gemini-2.5-flash are the web-search side calls. Gemini has no cache-write fee (cache_write = input).
# Not in this map: web search per-request fees (Anthropic $10/1k searches, Gemini grounding $35/1k prompts beyond 1,500/day).
AGENT_PRICES='{"claude-sonnet-5-5":{"input":2,"output":10,"cache_read":0.1,"cache_write":2.5},"claude-haiku-5-5":{"input":0.1,"output":0.5,"cache_read":0.01,"cache_write":0.125},"claude-haiku-4-5":{"input":1,"output":5,"cache_read":0.1,"cache_write":1.25},"gemini-2.5-flash":{"input":0.3,"output":2.5,"cache_read":0.03,"cache_write":0.3}}'
# Backend that grounds the out-of-band web-search call: gemini (Gemini + Google Search grounding,
# the default: owner decision 2026-11-09) or anthropic (Haiku + native web_search). Switch with a
# one-line edit + worker restart — no recompile. Only the selected backend's key must be set; without
# it web_search is withheld from the agent.
WEB_SEARCH_BACKEND=gemini
# Model for the Anthropic web-search backend (parses ?max_tokens= like the agent model string).
WEB_SEARCH_MODEL=claude-haiku-4-5?max_tokens=2048

# Model for the Gemini web-search backend (a Google Search-grounding capable flash model).
GEMINI_WEB_SEARCH_MODEL=gemini-2.5-flash
###< symfony/ai-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
# Dead letters of the async transport. in-memory:// (with MESSENGER_TRANSPORT_DSN=in-memory:// and
# AGENT_TURN_DISPATCH=terminate) keeps Messenger off Postgres entirely.
MESSENGER_FAILED_TRANSPORT_DSN=doctrine://default?queue_name=failed
###< symfony/messenger ###

###> agent turn dispatch ###
# Where POST /agent/turn runs the agent turn:
#   messenger — enqueue on the async transport, consumed by the `worker` container (local stack, Atelier).
#   terminate — run it in kernel.terminate of the same request, after the 202 is sent. No worker needed
#               (bonneref deployed alone); the PHP thread is busy for the turn's duration.
AGENT_TURN_DISPATCH=messenger
# terminate mode only: set_time_limit() for the turn, in seconds.
AGENT_TURN_TIME_LIMIT=120
# In-app turns per owner per sliding hour (they spend our Anthropic credits; MCP calls are not counted).
AGENT_TURN_RATE_LIMIT=30
# In-app turns across ALL owners per sliding hour: the ceiling on our Anthropic spend, whatever the
# number of accounts.
AGENT_TURN_GLOBAL_RATE_LIMIT=300
###< agent turn dispatch ###

###> rate limits (per owner, per sliding hour) ###
# /tts lines (ElevenLabs: a monthly character budget), /stt recordings, document + bill uploads.
SPEECH_RATE_LIMIT=300
TRANSCRIPTION_RATE_LIMIT=120
UPLOAD_RATE_LIMIT=60
# get_motul_oil lookups (a scrape of motul.com), MCP and in-app alike.
MOTUL_RATE_LIMIT=60
# /tts and /stt across ALL owners: the vendor ceiling, whatever the number of accounts.
SPEECH_GLOBAL_RATE_LIMIT=3000
TRANSCRIPTION_GLOBAL_RATE_LIMIT=1200
# Document, bill and turn-attachment uploads across ALL owners.
UPLOAD_GLOBAL_RATE_LIMIT=600
###< rate limits ###

###> maintenance bills and vehicle documents (storage) ###
# local (default): files under var/storage, no service to run. s3: any S3-compatible bucket; the
# S3_* values below must then be real (S3_ENDPOINT, S3_ACCESS_KEY, S3_SECRET_KEY).
STORAGE_ADAPTER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=maintenance
###< maintenance bills and vehicle documents (storage) ###

###> the Atelier's voice (docs/voice-plan.md) ###
# ElevenLabs is the only TTS backend (pocket-tts removed 2026-11-09, docs/archive/pocket-tts.md).
# Server-side only; the browser never sees this and only ever calls same-origin /tts.
# Empty = voice AND dictation are off: /agent/link reports them unavailable, the dashboard hides them,
# /tts and /stt answer 503 without calling the vendor.
ELEVENLABS_API_KEY=
# MEASURED: a free-tier key cannot use library voices via the API, and every FRENCH voice is a
# library voice — so this is an English default voice until the account is upgraded, after which
# swapping to a French voice id is this one line. See docs/voice-plan.md § Prerequisite.
ELEVENLABS_VOICE_ID=
# The English default voice; empty = ELEVENLABS_VOICE_ID for every locale.
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_MODEL=eleven_flash_v2_5
# ElevenLabs supports 0.7 to 1.2; values above 1.0 increase cadence. Keep the repository default
# neutral so stage/local deployment can opt in independently.
ELEVENLABS_SPEED=1.0
###< the Atelier's voice ###

###> the Atelier's ear (docs/dictation-plan.md) ###
# Which backend transcribes: elevenlabs. Same vendor and same key as the voice — a local whisper
# sidecar was measured first and lost (§ Measured: approximate at 464 MB, or 1.6 GB and slower than
# real time). Server-side only; the browser posts to same-origin /stt and never to the vendor.
STT_BACKEND=elevenlabs
# Scribe is the STT model family; the voice's ELEVENLABS_MODEL above is the TTS one and they are
# separate settings on purpose — one is a voice model, the other a transcription model. scribe_v1 is
# deprecated at the vendor; v2 is current. Note both sides spend ONE shared monthly credit pool
# (~330 credits per minute of audio).
ELEVENLABS_STT_MODEL=scribe_v2
###< the Atelier's ear ###

###> symfony/ai-anthropic-platform ###
# ANTHROPIC_API_KEY: declared above with the agent.
###< symfony/ai-anthropic-platform ###

