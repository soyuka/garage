# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Domain store: a separate Mongo database so the suite never touches dev data. The DBAL caches
# get their own _test-suffixed Postgres DB (doctrine.yaml) and DAMA rolls them back per test;
# Mongo has no such wrapper, so AppTestCase purges every collection in setUp().
MONGODB_DB=app_test

# bonneref is served by tests/Mock/BonnerefHttpClient; the host is only ever a base for relative paths.
BONNEREF_API_URL=https://bonneref.test

# OIDC: tokens are decoded by FakeOidcTokenHandler, so these are never hit by the
# cryptographic handler — only the metadata endpoint echoes the issuer.
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_AUDIENCE=test
# Audience: FakeOidcToken::ATELIER_CLIENT. The MCP resource alias is forced in phpunit.dist.xml.
OAUTH_CLIENT_AUDIENCES=test-atelier-client

# MCP_ALLOWED_HOSTS is NOT set here on purpose: the stage profile promotes it to a container env
# var, which Dotenv will not overwrite, so a value here would be silently ignored. It is forced in
# phpunit.dist.xml instead (see McpAllowedHostsTest).

# Voice: the vendor transport is tests/Mock/RecordingSpeechHttpClient, so these are never spent —
# they exist so the tests can assert the key, voice and model actually reach the outgoing request.
ELEVENLABS_API_KEY=test-xi-key
ELEVENLABS_VOICE_ID=test-voice-id
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_SPEED=1.0

###> the Atelier's ear ###
# The vendor transport in this env is App\Tests\Mock\RecordingTranscriptionHttpClient; no test
# reaches api.elevenlabs.io. The key/model come from the voice's own test values above.
STT_BACKEND=elevenlabs
ELEVENLABS_STT_MODEL=scribe_v2
###< the Atelier's ear ###

# Paid providers count as configured (App\Capability\Capabilities) only when their key is non-empty.
# Every platform is a test double, so these fake keys switch the features ON and are never spent;
# CapabilitiesTest blanks them one at a time to pin the switched-off behaviour.
ANTHROPIC_API_KEY=test-anthropic-key
GEMINI_API_KEY=test-gemini-key
WEB_SEARCH_BACKEND=gemini

# Pinned so journal cost assertions do not follow price changes in .env
AGENT_PRICES='{"claude-sonnet-5-5":{"input":2,"output":10,"cache_read":0.20,"cache_write":2.50},"claude-haiku-5-5":{"input":0.10,"output":0.50,"cache_read":0.01,"cache_write":0.125}}'
