# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Fake upstream credentials — all HTTP is served by tests/Mock/FixtureHttpClient.
# getModels/getCars left EMPTY on purpose: tests assert the 501 pending-token behavior.
API_PLAQUE_TOKEN=test-token
PARTSAPI_KEY_getMakes=test-key
PARTSAPI_KEY_getSearchTree=test-key
PARTSAPI_KEY_getArticles=test-key
PARTSAPI_KEY_GetFillVolumes=test-key

# OIDC: tokens are decoded by FakeOidcTokenHandler, so these are never hit by the
# cryptographic handler — only the metadata endpoint echoes the issuer.
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_AUDIENCE=test
