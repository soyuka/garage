{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	root /app/public
	encode zstd br gzip

	mercure {
		# Mercure 1.0 dropped the top-level publisher_jwt/subscriber_jwt directives: keys now hang off
		# the issuer that signed the token. `iss` must equal this identifier and `aud` must equal
		# resource_identifier, both minted by config/packages/mercure.yaml.
		issuer {$MERCURE_JWT_ISSUER:https://mon-parc-auto.fr} {
			publisher {
				jwt {env.MERCURE_PUBLISHER_JWT_KEY}
			}
			subscriber {
				jwt {env.MERCURE_SUBSCRIBER_JWT_KEY}
			}
		}
		# We publish through the internal URL but tokens carry the public one, so the audience the hub
		# expects has to be pinned instead of derived per request.
		resource_identifier {$MERCURE_PUBLIC_URL:https://localhost/.well-known/mercure}
		# Allow anonymous subscribers (double-check that it's what you want)
		anonymous
		# Enable the subscription API (double-check that it's what you want)
		subscriptions
		# Extra directives
		{$MERCURE_EXTRA_DIRECTIVES}
	}

	vulcain

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
	header ?Permissions-Policy "browsing-topics=()"

	# Single-domain serving: forward the dashboard (Vite/React dev server) and keep the API on PHP.
	# https://api-platform.com/docs/symfony/caddy/#serving-the-api-and-the-pwa-on-the-same-domain
	# Adapted for Vite instead of Next.js: the forwarded asset/HMR paths are Vite-specific
	# (/@vite, /@react-refresh, /src, /node_modules, /vite-hmr) rather than /_next.
	@frontend expression `(
			header({'Accept': '*text/html*'})
			&& !path(
				'/docs*', '/graphql*', '/bundles*', '/contexts*', '/_profiler*', '/_wdt*',
				'/mcp*', '/agent*', '/garage*', '/.well-known*',
				'*.json*', '*.html', '*.csv', '*.yml', '*.yaml', '*.xml'
			)
		)
		|| path(
			'/@vite/*', '/@react-refresh', '/@id/*', '/@fs/*', '/src/*', '/node_modules/*',
			'/vite-hmr*', '/__vite_ping', '/favicon.ico',
			'*.glb', '/draco/*', '/audio/*'
		)`

	# route {} enforces strict first-match-wins in file order, so the @frontend proxy is tried
	# before the PHP rewrite (Caddy's default directive order runs rewrite before reverse_proxy).
	route {
		# Same-origin proxy to Casdoor for the SPA's OAuth token exchange. The dashboard page is
		# served over HTTPS, so a fetch() to the plain-http Casdoor (http://casdoor:8000) is blocked
		# as mixed active content. Routing the token POST through this HTTPS origin removes the block;
		# the token `iss` is Casdoor's app.conf origin (http://casdoor:8000), independent of the URL
		# the browser used, so the API's issuer/JWKS check is unaffected. handle_path strips /casdoor.
		handle_path /casdoor/* {
			reverse_proxy http://{$CASDOOR_UPSTREAM:casdoor:8000}
		}

		# Vite dev server. Default upstream lets a PHP-only stack (no dashboard service) still parse;
		# requests then 502 only when something actually matches @frontend.
		reverse_proxy @frontend http://{$FRONTEND_UPSTREAM:dashboard:5173}

		@phpRoute {
			not path /.well-known/mercure*
			not file {path}
		}
		rewrite @phpRoute index.php

		# An MCP response carrying Mercure-Stream is a promise, not a body: the endpoint returns an
		# empty 200 and this handler swaps it for the hub's SSE, so no PHP thread stays parked on the
		# connection. Without the intercept the header reaches the client and no stream ever opens.
		# The hub is this same Caddy; MERCURE_URL is the in-container address the publisher already uses.
		intercept {
			@mercureStream header Mercure-Stream *
			handle_response @mercureStream {
				route {
					mercure_stream {$MERCURE_URL:http://php/.well-known/mercure} {
						# "ready" fires once the hub has accepted the subscription. The app only starts
						# publishing then: this module does no replay and sends no Last-Event-ID, so a
						# frame published before this point is gone.
						lifecycle_url {$MCP_STREAM_LIFECYCLE_URL:http://php/_mcp/stream-lifecycle}
						lifecycle_token {env.MCP_STREAM_LIFECYCLE_TOKEN}
						timeout {$MCP_STREAM_TIMEOUT:5m}
						idle_timeout {$MCP_STREAM_IDLE_TIMEOUT:60s}
					}
				}
			}
		}

		@frontController path index.php
		php @frontController {
			{$FRANKENPHP_SITE_CONFIG}

			worker {
				file ./public/index.php
				{$FRANKENPHP_WORKER_CONFIG}
			}
		}

		file_server {
			hide *.php
		}
	}
}

# The in-network entry point: the app publishes to the hub here, and Caddy posts the stream
# lifecycle callback here. Mercure 1.0 allows one unnamed hub per HTTP app and each `mercure`
# directive provisions its own, so declaring the hub again on this address would create a second one
# that never sees the first's updates. Everything is forwarded to the single site above instead.
# The certificate is Caddy's own, on a hop that never leaves the compose network.
http://php:80 {
	reverse_proxy https://{$MERCURE_INTERNAL_HOST:localhost} {
		transport http {
			tls
			tls_insecure_skip_verify
		}
		header_up Host {$MERCURE_INTERNAL_HOST:localhost}
	}
}
