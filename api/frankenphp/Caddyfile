{
	skip_install_trust

	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		{$FRANKENPHP_CONFIG}
	}
}

{$CADDY_EXTRA_CONFIG}

{$SERVER_NAME:localhost} {
	log {
		{$CADDY_SERVER_LOG_OPTIONS}
		# Redact the authorization query parameter that can be set by Mercure
		format filter {
			request>uri query {
				replace authorization REDACTED
			}
		}
	}

	root /app/public
	encode zstd br gzip

	mercure {
		# Publisher JWT key
		publisher_jwt {env.MERCURE_PUBLISHER_JWT_KEY} {env.MERCURE_PUBLISHER_JWT_ALG}
		# Subscriber JWT key
		subscriber_jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} {env.MERCURE_SUBSCRIBER_JWT_ALG}
		# Allow anonymous subscribers (double-check that it's what you want)
		anonymous
		# Enable the subscription API (double-check that it's what you want)
		subscriptions
		# Extra directives
		{$MERCURE_EXTRA_DIRECTIVES}
	}

	vulcain

	{$CADDY_SERVER_EXTRA_DIRECTIVES}

	# Disable Topics tracking if not enabled explicitly: https://github.com/jkarlin/topics
	header ?Permissions-Policy "browsing-topics=()"

	# Single-domain serving: forward the dashboard (Vite/React dev server) and keep the API on PHP.
	# https://api-platform.com/docs/symfony/caddy/#serving-the-api-and-the-pwa-on-the-same-domain
	# Adapted for Vite instead of Next.js: the forwarded asset/HMR paths are Vite-specific
	# (/@vite, /@react-refresh, /src, /node_modules, /vite-hmr) rather than /_next.
	@frontend expression `(
			header({'Accept': '*text/html*'})
			&& !path(
				'/docs*', '/graphql*', '/bundles*', '/contexts*', '/_profiler*', '/_wdt*',
				'/mcp*', '/agent*', '/garage*', '/.well-known*',
				'*.json*', '*.html', '*.csv', '*.yml', '*.yaml', '*.xml'
			)
		)
		|| path(
			'/@vite/*', '/@react-refresh', '/@id/*', '/@fs/*', '/src/*', '/node_modules/*',
			'/vite-hmr*', '/__vite_ping', '/favicon.ico',
			'*.glb', '/draco/*'
		)`

	# route {} enforces strict first-match-wins in file order, so the @frontend proxy is tried
	# before the PHP rewrite (Caddy's default directive order runs rewrite before reverse_proxy).
	route {
		# Same-origin proxy to Casdoor for the SPA's OAuth token exchange. The dashboard page is
		# served over HTTPS, so a fetch() to the plain-http Casdoor (http://casdoor:8000) is blocked
		# as mixed active content. Routing the token POST through this HTTPS origin removes the block;
		# the token `iss` is Casdoor's app.conf origin (http://casdoor:8000), independent of the URL
		# the browser used, so the API's issuer/JWKS check is unaffected. handle_path strips /casdoor.
		handle_path /casdoor/* {
			reverse_proxy http://{$CASDOOR_UPSTREAM:casdoor:8000}
		}

		# Vite dev server. Default upstream lets a PHP-only stack (no dashboard service) still parse;
		# requests then 502 only when something actually matches @frontend.
		reverse_proxy @frontend http://{$FRONTEND_UPSTREAM:dashboard:5173}

		@phpRoute {
			not path /.well-known/mercure*
			not file {path}
		}
		rewrite @phpRoute index.php

		@frontController path index.php
		php @frontController {
			{$FRANKENPHP_SITE_CONFIG}

			worker {
				file ./public/index.php
				{$FRANKENPHP_WORKER_CONFIG}
			}
		}

		file_server {
			hide *.php
		}
	}
}
