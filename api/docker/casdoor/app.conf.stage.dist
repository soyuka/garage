# Casdoor config for the STAGE profile (the conference rig). Template — copy to `app.conf.stage`
# (gitignored) and fill the CHANGEME values. Diverges from app.conf in exactly two places; the rest
# is copied verbatim so a future edit to the dev file can be diffed against this one.
#
#  1. `origin` — moved off http://casdoor:8000 to the public host. This is what Casdoor uses to build
#     every URL it advertises in discovery (authorization_endpoint, token_endpoint, jwks_uri), so
#     Claude Desktop cannot complete the OAuth dance until it points somewhere Desktop can reach.
#     It is ALSO the token `iss`, so it must equal CASDOOR_ISSUER in .env.stage character for
#     character — CasdoorTokenHandler validates issuer + signature, and a mismatch rejects
#     every token with no useful message.
#  2. `dataSourceName` — the real Postgres password from .env.stage, since this file is not
#     env-interpolated.
#
# Casdoor gets its own hostname (auth.soyuka.me) rather than a path under the app host: `origin`
# feeds every advertised URL, and Casdoor's handling of a path-prefixed origin is unverified.
#
# BEFORE THE TUNNEL OPENS: log in as built-in/admin (seeded at password `123` by init_data.json) and
# change that password. Publicly reachable, it is a takeover of the authorization server gating /mcp.
# While you are in there, set Organization "built-in" → dcrPolicy = "open" so Claude Desktop can
# self-register via anonymous RFC 7591 DCR, and add Claude's OAuth callback to the allowed redirect
# URIs of the application it registers against.
appname = casdoor
httpport = 8000
runmode = prod
copyrequestbody = true
driverName = postgres
dataSourceName = "user=app password=CHANGEME host=database port=5432 sslmode=disable dbname=postgres"
dbName = casdoor
tableNamePrefix =
showSql = false
redisEndpoint =
defaultStorageProvider =
isCloudIntranet = false
authState = "casdoor"
socks5Proxy = ""
verificationCodeTimeout = 10
initScore = 0
logPostOnly = true
isUsernameLowered = false
origin = "https://auth.soyuka.me"
originFrontend =
staticBaseUrl = "https://cdn.casbin.org"
isDemoMode = false
batchSize = 100
showGithubCorner = false
forceLanguage = ""
defaultLanguage = "en"
aiAssistantUrl = "https://ai.casbin.com"
defaultApplication = "app-built-in"
maxItemsForFlatMenu = 7
enableErrorMask = false
enableGzip = true
inactiveTimeoutMinutes =
ldapServerPort = 389
ldapsCertId = ""
ldapsServerPort = 636
radiusServerPort = 1812
radiusDefaultOrganization = "built-in"
radiusSecret = "CHANGEME"
quota = {"organization": -1, "user": -1, "application": -1, "provider": -1}
logConfig = {"adapter":"file", "filename": "logs/casdoor.log", "maxdays":99999, "perm":"0770"}
initDataNewOnly = false
initDataFile = "./init_data.json"
frontendBaseDir = "../cc_0"
