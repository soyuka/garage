#!/usr/bin/env bash
# Offline demo (compose.demo.yaml): bin/demo [up|down|reset|info]
#   up     get the images, start, seed the demo garage on first boot, print URLs and login (default)
#          images: pulled from ghcr.io at DEMO_IMAGE_TAG (v1.0.1, `main` follows the branch), built from this
#          checkout when the pull fails; `up --build` (or DEMO_BUILD=1) builds all three locally
#   down   stop the stack, data kept (bin/demo down -v also deletes it)
#   reset  reload the demo garage from api/fixtures/demo, discarding changes
#   info   print URLs and login
# Catalogue: data/catalog-demo.sqlite, or DEMO_CATALOG_PATH=<a catalog.sqlite> in the environment.
# Secrets are generated once into .demo/env (git-ignored). Ports: DEMO_PORT, BONNEREF_PORT, AUTH_PORT
# on the first run, or edit .demo/env afterwards (the Atelier bakes AUTH_PORT in: the published image only
# matches the default 8482, any other value builds the Atelier locally).
set -euo pipefail

cd "$(dirname "$0")/.."
export DEMO_IMAGE_TAG=${DEMO_IMAGE_TAG:-v1.0.1}
STATE=.demo
ENV_FILE=$STATE/env

compose() {
	docker compose -p "${DEMO_PROJECT:-mpa-demo}" --env-file "$ENV_FILE" -f compose.demo.yaml "$@"
}

secret() {
	local value=''
	while [ "${#value}" -lt "$1" ]; do
		value+=$(head -c 64 /dev/urandom | base64 | tr -dc 'A-Za-z0-9')
	done
	printf '%s' "${value:0:$1}"
}

init_env() {
	mkdir -p "$STATE"
	chmod 700 "$STATE"
	if [ ! -f "$ENV_FILE" ]; then
		umask 077
		cat >"$ENV_FILE" <<-EOF
			DEMO_PORT=${DEMO_PORT:-8480}
			BONNEREF_PORT=${BONNEREF_PORT:-8481}
			AUTH_PORT=${AUTH_PORT:-8482}
			DEMO_EMAIL=demo@bonneref.fr
			DEMO_PASSWORD=demo-$(secret 12)
			MPA_APP_SECRET=$(secret 32)
			BONNEREF_APP_SECRET=$(secret 32)
			MERCURE_JWT_SECRET=$(secret 48)
			POSTGRES_PASSWORD=$(secret 24)
			CASDOOR_CLIENT_SECRET=$(secret 40)
			MPA_SERVICE_CLIENT_SECRET=$(secret 40)
		EOF
		echo "Generated $ENV_FILE"
	fi
	# Added 2026-11-15 (mpa calls bonneref with its own client credentials): an older .demo/env lacks it.
	if ! grep -q '^MPA_SERVICE_CLIENT_SECRET=' "$ENV_FILE"; then
		(umask 077 && printf 'MPA_SERVICE_CLIENT_SECRET=%s\n' "$(secret 40)" >>"$ENV_FILE")
		echo "Added MPA_SERVICE_CLIENT_SECRET to $ENV_FILE"
	fi
	local catalog_override=${DEMO_CATALOG_PATH:-}
	set -a
	# shellcheck source=/dev/null
	. "./$ENV_FILE"
	set +a
	export DEMO_CATALOG_PATH=${catalog_override:-${DEMO_CATALOG_PATH:-./data/catalog-demo.sqlite}}
}

render_casdoor_seed() {
	sed \
		-e "s|@DEMO_PORT@|$DEMO_PORT|g" \
		-e "s|@DEMO_EMAIL@|$DEMO_EMAIL|g" \
		-e "s|@DEMO_PASSWORD@|$DEMO_PASSWORD|g" \
		-e "s|@CASDOOR_CLIENT_SECRET@|$CASDOOR_CLIENT_SECRET|g" \
		-e "s|@MPA_SERVICE_CLIENT_SECRET@|$MPA_SERVICE_CLIENT_SECRET|g" \
		docker/demo/casdoor-init.json.dist >"$STATE/casdoor-init.json"
	# Read by the Casdoor container's own user; the 700 directory keeps it from other host users.
	chmod 644 "$STATE/casdoor-init.json"
}

# Services whose image compose.demo.yaml names on ghcr.io and also knows how to build (the worker shares php's).
BUILDABLE=(php bonneref atelier)
PUBLISHED_AUTH_PORT=8482

image_of() {
	case "$1" in
	php) echo ghcr.io/soyuka/mon-parc-auto-api:$DEMO_IMAGE_TAG ;;
	bonneref) echo ghcr.io/soyuka/mon-parc-auto-bonneref:$DEMO_IMAGE_TAG ;;
	atelier) echo ghcr.io/soyuka/mon-parc-auto-atelier:$DEMO_IMAGE_TAG ;;
	esac
}

# Compose versions differ on whether `up` pulls an absent image before building it, so the pull is explicit.
prepare_images() {
	local service
	if [ "${DEMO_BUILD:-0}" = 1 ]; then
		echo "Images: building php, bonneref and atelier from this checkout (--build)."
		compose build "${BUILDABLE[@]}"
		return
	fi
	for service in "${BUILDABLE[@]}"; do
		if [ "$service" = atelier ] && [ "$AUTH_PORT" != "$PUBLISHED_AUTH_PORT" ]; then
			echo "Images: atelier built from this checkout (AUTH_PORT=$AUTH_PORT is compiled in, the published image has $PUBLISHED_AUTH_PORT)."
			compose build "$service"
		elif compose pull --quiet "$service" 2>/dev/null; then
			echo "Images: $service pulled from ghcr.io."
		elif docker image inspect "$(image_of "$service")" >/dev/null 2>&1; then
			echo "Images: $service not pullable (private package or offline), using the local copy."
		else
			echo "Images: $service not pullable (private package or offline), building from this checkout."
			compose build "$service"
		fi
	done
}

check_catalog() {
	if [ ! -f "$DEMO_CATALOG_PATH" ]; then
		# Docker would bind-mount a fresh empty directory in its place.
		echo "No TecDoc catalogue at DEMO_CATALOG_PATH=$DEMO_CATALOG_PATH (the default is the committed data/catalog-demo.sqlite)." >&2
		exit 1
	fi
}

load_garage() {
	compose exec -T php php -d memory_limit=1G bin/console app:demo:load --owner="$DEMO_EMAIL" --no-interaction
}

garage_is_empty() {
	local count
	count=$(compose exec -T mongodb mongosh app --quiet --eval "db.vehicles.countDocuments({owner: '$DEMO_EMAIL'})" | tr -dc '0-9')
	[ "${count:-0}" = 0 ]
}

info() {
	cat <<-EOF

		  Atelier              http://localhost:$DEMO_PORT
		  mpa MCP server       http://localhost:$DEMO_PORT/mcp
		  bonneref MCP server  http://localhost:$BONNEREF_PORT/mcp
		  Casdoor (issuer)     http://localhost:$AUTH_PORT

		  Login                demo / $DEMO_PASSWORD   ($DEMO_EMAIL)

		  claude mcp add --transport http garage http://localhost:$DEMO_PORT/mcp
		  claude mcp add --transport http bonneref http://localhost:$BONNEREF_PORT/mcp
		  then /mcp in Claude Code to log in (the client registers itself).

	EOF
}

command=up
if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
	command=$1
	shift
fi

args=()
for arg in "$@"; do
	if [ "$arg" = --build ]; then
		DEMO_BUILD=1
	else
		args+=("$arg")
	fi
done
set -- ${args[@]+"${args[@]}"}

case "$command" in
up)
	init_env
	render_casdoor_seed
	check_catalog
	prepare_images
	compose up -d --wait --wait-timeout 600 "$@"
	if garage_is_empty; then
		load_garage
	fi
	info
	;;
down)
	init_env
	compose down "$@"
	;;
reset)
	init_env
	load_garage
	;;
info)
	init_env
	info
	;;
*)
	sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
	exit 1
	;;
esac
