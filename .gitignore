# Theming workshop — source assets + staging. The runtime web glb the app loads
# are tracked under dashboard/public/; everything here is Blender/SketchUp source,
# raw exports, reference images, and design scratch — kept out of git (138M+).
/theming/

# Working scratch prompts (not fixtures, not referenced in code). Unanchored: they
# turn up per-surface too (stage/NEXT_PROMPT.md is the pilot session's scratch).
NEXT_PROMPT.md
prompt.md

# Sample/working invoice PDFs (not referenced in code).
/api/tondeuse/

# Claude Code local state (settings, agent memory, worktrees). Root state is private;
# per-surface agent memory too — but stage/.claude/ IS tracked, it is the pilot rig.
/.claude/
**/.claude/agent-memory/

# Same posture for the other agent CLIs' local state: vendored skills, hooks, and AGENTS.md —
# which is a machine-substituted copy of CLAUDE.md ("Codex.ai/code"), so tracking it would only
# let the two drift.
/.agents/
/.codex/
/AGENTS.md

# Runtime logs of the stage rig (cloudflared).
/stage/var/

# Audition masters and the superseded first cue palette — same posture as /theming/ above: the
# listening set (mp3 + wav masters, their metadata, the generate*.sh recipes and index.html) is
# design scratch, ~5 MB that no code loads. The runtime palette IS tracked, under its dated
# directory dashboard/public/audio/spatial-2026-09-11/. The links to the audition index from
# docs/transition-sound-direction.md and docs/voice.md therefore only resolve locally.
/docs/audio-candidates-2026-09-11/
/dashboard/public/audio/*.wav

/demo/
# Local-only working material, never published.
/video/
/blueprint-experiment/
/.impeccable/
/bonneref/src/.impeccable/

# Data dumps and local databases, wherever they land (api/bin/backup writes outside the repo by
# default; this catches an MPA_BACKUP_DIR pointed inside it, or a stray mongodump).
*.sqlite
*.bson
*.archive.gz
dumps/
backups/

# Offline demo state (bin/demo): generated secrets, the rendered Casdoor seed.
/.demo/
# The committed TecDoc slice the offline demo mounts (compose.demo.yaml, DEMO_CATALOG_PATH).
!/data/catalog-demo.sqlite
